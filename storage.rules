rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return role() in ['super_admin', 'admin'];
    }

    function canReadPatientPhotos() {
      return role() in ['super_admin', 'admin', 'sub_admin', 'doctor', 'staff', 'reception', 'viewer'];
    }

    function canUpload() {
      return role() in ['super_admin', 'admin', 'sub_admin', 'doctor', 'staff', 'accounts', 'reception'];
    }

    match /branding/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /profile-photos/patients/{patientId}/{fileName} {
      allow read: if canReadPatientPhotos();
      allow write: if canUpload()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /profile-photos/staff/{staffUid}/{fileName} {
      allow read: if role() in ['super_admin', 'admin', 'sub_admin'];
      allow write: if role() in ['super_admin', 'admin', 'sub_admin']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /patient-files/{patientId}/{fileName} {
      allow read: if signedIn();
      allow write: if canUpload()
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if role() in ['super_admin', 'admin'];
    }

    match /documents/{allPaths=**} {
      allow read: if signedIn();
      allow write: if canUpload()
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if role() in ['super_admin', 'admin'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
