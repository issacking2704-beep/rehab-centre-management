rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {\n      return role() in ['super_admin', 'admin'];\n    }\n\n    function canUpload() {
      return role() in ['super_admin', 'admin', 'doctor', 'staff', 'accounts', 'reception'];
    }

    match /branding/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /patient-files/{patientId}/{fileName} {
      allow read: if signedIn();
      allow write: if canUpload()
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if role() in ['super_admin', 'admin'];
    }

    match /documents/{allPaths=**} {
      allow read: if signedIn();
      allow write: if canUpload()
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if role() in ['super_admin', 'admin'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
